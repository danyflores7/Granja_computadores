# ==============================================================================
# Variables de entorno para el clúster MPI con Tailscale sidecar
# 
# INSTRUCCIONES:
# 1. Ve a https://login.tailscale.com/admin/settings/keys
# 2. Haz clic en "Generate auth key"
# 3. Marca: "Reusable" = SI, "Ephemeral" = SI, "Pre-authorized" = SI
# 4. Copia la clave y pégala abajo en TS_AUTHKEY
#
# IMPORTANTE: Usa el MISMO TS_AUTHKEY en las 3 máquinas.
# Solo cambia TS_HOSTNAME en cada máquina (ver abajo).
# ==============================================================================

# Auth key de Tailscale (misma en las 3 máquinas)
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Nombre único del nodo en Tailscale (DIFERENTE en cada máquina):
# - En Windows Master (esta máquina): mpi-master
# - En Mac esclavo:                   mpi-mac-slave
# - En Windows esclavo:               mpi-win-slave
TS_HOSTNAME=mpi-master
